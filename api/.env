# ===========================================
# Omfluence API Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Generate secure secrets (at least 32 characters):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=b9a419473ae1a8e53937b9318a0db35499d9a374aac7e4c8a6ee64b1d0d38bed
JWT_REFRESH_SECRET=b42b94b8cac7712d15da04b25dd43120d77871f7c45c77e57ace8bd6a366bdb4

# Token expiration times (optional, defaults shown)
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# -------------------------------------------
# MongoDB Database
# -------------------------------------------
# Local development
MONGODB_URI=mongodb://localhost:27017/omfluence

# Or MongoDB Atlas (production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/omfluence?retryWrites=true&w=majority

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# CORS Configuration
# -------------------------------------------
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3001
